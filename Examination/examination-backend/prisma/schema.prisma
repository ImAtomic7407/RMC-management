model practice_attempt_results {
  id                                   Int      @id @default(autoincrement())
  practice_attempt_id                  Int      @unique
  total_score                          Decimal
  max_score                            Decimal
  percentage                           Decimal
  correct_count                        Int
  wrong_count                          Int
  unattempted_count                    Int
  result_released_at                   DateTime?
  evaluated_question_paper_version_id  Int?
  evaluated_question_paper_version_number Int?
  scoring_source                       String?  @default("SELF_PRACTICE_VERSION")
  created_at                           DateTime @default(now())
  updated_at                           DateTime @updatedAt

  practice_attempt practice_attempts @relation(fields: [practice_attempt_id], references: [id], onDelete: Cascade)

  @@index([practice_attempt_id])
  @@index([evaluated_question_paper_version_id])
}

model practice_question_attempts {
  id                  Int      @id @default(autoincrement())
  student_id          Int
  exam_id             Int
  question_id         Int
  attempt_count       Int      @default(0)
  wrong_count         Int      @default(0)
  correct_count       Int      @default(0)
  last_answer         String?
