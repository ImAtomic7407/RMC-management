  tie_break_value Int?
  created_at      DateTime         @default(now())
  updated_at      DateTime         @updatedAt

  attempt exam_attempts @relation(fields: [attempt_id], references: [id], onDelete: Cascade)
  student student_profiles @relation(fields: [student_id], references: [id], onDelete: Cascade)

