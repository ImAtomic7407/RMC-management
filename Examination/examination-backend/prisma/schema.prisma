  updated_at            DateTime @updatedAt

  practice_attempt practice_attempts @relation(fields: [practice_attempt_id], references: [id], onDelete: Cascade)
  version_question question_paper_version_questions @relation(fields: [version_question_id], references: [id], onDelete: Cascade)
  selected_option question_paper_version_options? @relation(fields: [selected_option_id], references: [id], onDelete: SetNull)

  @@unique([practice_attempt_id, version_question_id])
  @@index([practice_attempt_id, version_question_id])
  @@index([version_question_id])
}

model practice_attempt_section_results {
