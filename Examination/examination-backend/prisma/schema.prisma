  practice_attempt_id Int
  section_code      SectionCode
  score             Decimal
  correct_count     Int
  wrong_count       Int
  unattempted_count Int
  max_score         Decimal
  created_at        DateTime     @default(now())
  updated_at        DateTime     @updatedAt

  practice_attempt practice_attempts @relation(fields: [practice_attempt_id], references: [id], onDelete: Cascade)

  @@unique([practice_attempt_id, section_code])
  @@index([practice_attempt_id, section_code])
