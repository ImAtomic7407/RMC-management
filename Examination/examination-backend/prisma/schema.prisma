model exam_audit_logs {
  id             Int            @id @default(autoincrement())
  actor_user_id  Int?
  actor_role     AuditActorRole
  action         String
  entity_type    String
  entity_id      String
  metadata_json  String?
  ip_address     String?
  device_id      String?
  created_at     DateTime       @default(now())

  actor users? @relation("audit_actor", fields: [actor_user_id], references: [id], onDelete: SetNull)

  @@index([entity_type, entity_id])
  @@index([actor_user_id, created_at])
  @@index([action, created_at])
}

// OTA Update Registry — tracks published APK releases and pre-generated binary patches
model apk_releases {
  id              Int      @id @default(autoincrement())
  version_code    Int      @unique
  version_name    String
  apk_path        String   // server-relative path, e.g. uploads/releases/v4.apk
  file_size       Int      // bytes
  sha256          String
  release_notes   String   @default("[]") // JSON array of strings
  mandatory       Boolean  @default(false)
  published_at    DateTime @default(now())
  created_at      DateTime @default(now())

  patches_from    apk_patches[] @relation("patch_source")
  patches_to      apk_patches[] @relation("patch_target")

  @@index([version_code])
  @@index([published_at])
}

model apk_patches {
  id                  Int      @id @default(autoincrement())
  from_version_code   Int
  to_version_code     Int
  patch_path          String   // server-relative path, e.g. uploads/patches/v3_to_v4.patch.gz
  patch_size          Int      // compressed patch bytes
  full_apk_size       Int      // size of the full target APK (for strategy comparison)
  sha256              String   // SHA-256 of the decompressed patch file
  created_at          DateTime @default(now())

  source_release  apk_releases @relation("patch_source", fields: [from_version_code], references: [version_code], onDelete: Cascade)
  target_release  apk_releases @relation("patch_target", fields: [to_version_code], references: [version_code], onDelete: Cascade)

  @@unique([from_version_code, to_version_code])
  @@index([from_version_code])
  @@index([to_version_code])
}

