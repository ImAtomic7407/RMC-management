<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>RMC | Reports</title>
    <link rel="stylesheet" href="/css/index.css">
</head>
<body class="dashboard-layout">
    <div class="vibrant-bg">
        <div class="blob blob-1"></div>
        <div class="blob blob-2"></div>
        <div class="blob blob-3"></div>
        <div class="blob blob-4"></div>
        <div class="blob blob-5"></div>
    </div>

    <%- include('partials/sidebar', { user, activePage: 'reports' }) %>

    <main class="main-content">
        <header class="content-header">
            <div class="h-info">
                <h1>Reports</h1>
                <p>View batch attendance and export CSV files.</p>
            </div>
            <div class="h-actions">
                <button class="btn-neon" onclick="exportSelectedBatch()">Export Selected Batch</button>
                <button class="btn-glass" onclick="exportMasterData()">Export Full Data</button>
            </div>
        </header>

        <section class="reports-grid">
            <div class="glass-container pane">
                <div class="filter-bar">
                    <div class="input-group">
                        <label>Batch</label>
                        <select id="report-batch-select" class="input-glass" onchange="loadReportData()">
                            <option value="ALL">All Batches</option>
                        </select>
                    </div>
                </div>

                <div class="table-wrapper mt-40">
                    <table>
                        <thead>
                            <tr>
                                <th>UID</th>
                                <th>Name</th>
                                <th>Batch</th>
                                <th>Attendance %</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody id="report-table-body"></tbody>
                    </table>
                </div>
            </div>
        </section>

        <section class="glass-container pane mt-40">
            <div class="pane-header">
                <h3>Weekly Attendance Alerts</h3>
                <p>Students below 75% attendance in the last 7 days.</p>
            </div>
            <div id="attendance-alerts-list" class="alerts-stack"></div>
        </section>
    </main>

    <div id="profile-modal" class="overlay-glass hidden">
        <div class="glass-container modal-card profile-modal-card">
            <div class="profile-header">
                <img id="modal-photo" src="" class="profile-photo" alt="Student Photo">
                <div class="profile-heading">
                    <h3 id="modal-name">Student</h3>
                    <p id="modal-uid" class="uid-tag"></p>
                    <p id="modal-batch" class="batch-badge"></p>
                </div>
            </div>

            <div class="profile-grid">
                <div class="profile-detail"><label>Phone</label><span id="modal-phone">-</span></div>
                <div class="profile-detail"><label>Father</label><span id="modal-father">-</span></div>
                <div class="profile-detail"><label>Guardian</label><span id="modal-guardian">-</span></div>
                <div class="profile-detail"><label>Class</label><span id="modal-class">-</span></div>
                <div class="profile-detail"><label>Aspiration</label><span id="modal-aspiration">-</span></div>
                <div class="profile-detail"><label>Attendance %</label><span id="modal-att-pct">0%</span></div>
            </div>

            <div class="table-wrapper mt-20">
                <table>
                    <thead>
                        <tr>
                            <th>Session</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody id="modal-attendance-body"></tbody>
                </table>
            </div>

            <button class="btn-glass danger" style="width: 100%; margin-top: 15px;" onclick="closeProfile()">Close</button>
        </div>
    </div>

    <script>
        const reportTable = document.getElementById('report-table-body');
        const rBatchSelect = document.getElementById('report-batch-select');
        const attendanceAlertsList = document.getElementById('attendance-alerts-list');
        let selectedBatchReport = null;
        let weeklyAlerts = [];

        async function initReports() {
            const bRes = await fetch('/api/batches');
            const batches = await bRes.json();
            batches.forEach((b) => {
                const opt = document.createElement('option');
                opt.value = b.name;
                opt.textContent = b.name;
                rBatchSelect.appendChild(opt);
            });
            loadReportData();
        }

        async function loadReportData() {
            const batch = rBatchSelect.value;

            if (batch === 'ALL') {
                selectedBatchReport = null;
                const res = await fetch('/api/students');
                const students = await res.json();
                reportTable.innerHTML = students.map((s) => `
                    <tr class="glow-on-hover">
                        <td><span class="uid-tag">${s.student_uid}</span></td>
                        <td><span class="name-bold">${s.name}</span></td>
                        <td><span class="batch-badge">${s.batch_name}</span></td>
                        <td><span class="p-val">-</span></td>
                        <td><button class="btn-glass sm info" onclick="viewProfile('${s.student_uid}')">View</button></td>
                    </tr>
                `).join('');
                return;
            }

            const res = await fetch(`/api/reports/batch/${encodeURIComponent(batch)}`);
            const report = await res.json();
            if (report.status !== 'success') {
                selectedBatchReport = null;
                reportTable.innerHTML = '';
                return;
            }

            selectedBatchReport = report;
            reportTable.innerHTML = report.students.map((s) => `
                <tr class="glow-on-hover">
                    <td><span class="uid-tag">${s.student_uid}</span></td>
                    <td><span class="name-bold">${s.name}</span></td>
                    <td><span class="batch-badge">${s.current_batch || report.batch}</span></td>
                    <td><span class="p-val">${s.attendance_percent}%</span></td>
                    <td><button class="btn-glass sm info" onclick="viewProfile('${s.student_uid}')">View</button></td>
                </tr>
            `).join('');
        }

        async function loadAttendanceAlerts() {
            const res = await fetch('/api/reports/attendance_alerts');
            const payload = await res.json();
            if (!payload || payload.status !== 'success' || !Array.isArray(payload.alerts)) {
                weeklyAlerts = [];
                attendanceAlertsList.innerHTML = '<p class="empty">No weekly alerts yet.</p>';
                return;
            }

            weeklyAlerts = payload.alerts;
            if (!weeklyAlerts.length) {
                attendanceAlertsList.innerHTML = '<p class="empty">No weekly alerts yet.</p>';
                return;
            }

            attendanceAlertsList.innerHTML = weeklyAlerts.map((alert) => {
                const lowStudents = Array.isArray(alert.lowAttendanceStudents) ? alert.lowAttendanceStudents : [];
                const preview = lowStudents.map((student) => `
                    <div class="alert-student">
                        <strong>${student.name}</strong>
                        <span>${student.student_uid}</span>
                        <span>${student.phone || '-'}</span>
                        <span>${student.current_batch || alert.batch_id || '-'}</span>
                        <span>${student.attendance_percent ?? 0}%</span>
                    </div>
                `).join('');

                return `
                    <article class="alert-card glass-container">
                        <div class="alert-head">
                            <div>
                                <span class="alert-badge">Low attendance</span>
                                <h4>${alert.batch_id}</h4>
                                <p>${alert.summary}</p>
                            </div>
                            <div class="alert-meta">
                                <span>${new Date(alert.created_at).toLocaleString()}</span>
                                <span>${alert.low_count || 0} students</span>
                            </div>
                        </div>
                        <div class="alert-grid">
                            ${preview || '<p class="empty">No students crossed the threshold.</p>'}
                        </div>
                    </article>
                `;
            }).join('');
        }

        function exportMasterData() {
            window.location.href = '/api/admin/export_csv';
        }

        function exportSelectedBatch() {
            const batch = rBatchSelect.value;
            if (batch === 'ALL') {
                alert('Please select one batch first.');
                return;
            }
            window.location.href = `/api/admin/export_csv?batch=${encodeURIComponent(batch)}`;
        }

        async function viewProfile(uid) {
            if (selectedBatchReport) {
                const student = selectedBatchReport.students.find((s) => s.student_uid === uid);
                if (student) {
                    fillProfileModal(student, selectedBatchReport.sessions);
                    return;
                }
            }

            const res = await fetch(`/api/student_details/${uid}`);
            const payload = await res.json();
            if (payload.status === 'success') {
                fillProfileModal(payload.data, []);
            }
        }

        function fillProfileModal(student, sessions) {
            document.getElementById('modal-photo').src = student.photo_path || '';
            document.getElementById('modal-name').innerText = student.name || '-';
            document.getElementById('modal-uid').innerText = student.student_uid || '-';
            document.getElementById('modal-batch').innerText = student.current_batch || student.batch_name || '-';
            document.getElementById('modal-phone').innerText = student.phone || '-';
            document.getElementById('modal-father').innerText = student.father_name || '-';
            document.getElementById('modal-guardian').innerText = student.guardian_phone || '-';
            document.getElementById('modal-class').innerText = student.student_class || '-';
            document.getElementById('modal-aspiration').innerText = student.aspiration || '-';
            document.getElementById('modal-att-pct').innerText = `${student.attendance_percent ?? 0}%`;

            const body = document.getElementById('modal-attendance-body');
            if (!sessions || sessions.length === 0) {
                body.innerHTML = '<tr><td colspan="2" style="color: var(--text-secondary);">Select one batch to view attendance-by-session here.</td></tr>';
            } else {
                body.innerHTML = sessions.map((session) => `
                    <tr>
                        <td>${session.label}</td>
                        <td>${(student.attendance && student.attendance[String(session.id)]) || 'Absent'}</td>
                    </tr>
                `).join('');
            }

            document.getElementById('profile-modal').classList.remove('hidden');
        }

        function closeProfile() {
            document.getElementById('profile-modal').classList.add('hidden');
        }

        initReports();
        loadAttendanceAlerts();
    </script>

    <style>
        .filter-bar { display: flex; gap: 20px; }
        .pane { padding: 40px; margin-top: 40px; }
        .uid-tag { font-family: monospace; color: #3b82f6; font-weight: 700; }
        .name-bold { color: var(--text-primary); font-weight: 600; }
        .batch-badge { background: rgba(59,130,246,0.1); color: #3b82f6; padding: 6px 12px; border-radius: 6px; font-size: 0.82rem; font-weight: 800; text-transform: uppercase; }
        .p-val { color: #22c55e; font-weight: 900; }
        .overlay-glass { position: fixed; inset: 0; background: rgba(0,0,0,0.8); backdrop-filter: blur(20px); z-index: 2000; display: flex; align-items: center; justify-content: center; }
        .modal-card { padding: 40px; width: 100%; max-width: 500px; text-align: center; border-radius: 30px; }
        .profile-modal-card { max-width: 920px; text-align: left; }
        .hidden { display: none; }
        .mt-20 { margin-top: 20px; }
        .mt-40 { margin-top: 40px; }
        .profile-header { display: flex; align-items: center; gap: 20px; margin-bottom: 20px; }
        .profile-photo { width: 96px; height: 96px; border-radius: 14px; object-fit: cover; border: 2px solid rgba(59,130,246,0.4); }
        .profile-heading h3 { margin: 0; color: var(--text-primary); font-size: 1.3rem; }
        .profile-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin-bottom: 18px; }
        .profile-detail { padding: 10px 12px; border-radius: 10px; border: 1px solid var(--glass-border); background: rgba(255,255,255,0.02); }
        .profile-detail label { display: block; color: var(--text-secondary); font-size: 0.74rem; text-transform: uppercase; letter-spacing: 0.8px; margin-bottom: 4px; }
        .profile-detail span { color: var(--text-primary); font-size: 0.95rem; font-weight: 600; }
        .alerts-stack { display: grid; gap: 16px; }
        .alert-card { padding: 22px; border-radius: 20px; }
        .alert-head { display: flex; justify-content: space-between; gap: 16px; align-items: flex-start; margin-bottom: 18px; }
        .alert-head h4 { color: var(--text-primary); margin: 6px 0 4px; font-size: 1.05rem; }
        .alert-head p { color: var(--text-secondary); line-height: 1.5; }
        .alert-badge { display: inline-flex; align-items: center; padding: 4px 10px; border-radius: 999px; font-size: 0.68rem; font-weight: 900; letter-spacing: 0.7px; text-transform: uppercase; color: #fecaca; background: rgba(239,68,68,0.12); border: 1px solid rgba(239,68,68,0.18); }
        .alert-meta { display: flex; flex-direction: column; gap: 6px; text-align: right; color: var(--text-secondary); font-size: 0.82rem; }
        .alert-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
        .alert-student { display: grid; gap: 4px; padding: 12px; border-radius: 12px; border: 1px solid var(--glass-border); background: rgba(255,255,255,0.02); }
        .alert-student strong { color: var(--text-primary); font-size: 0.95rem; }
        .alert-student span { color: var(--text-secondary); font-size: 0.82rem; }
        @media (max-width: 960px) { .profile-grid { grid-template-columns: 1fr 1fr; } }
        @media (max-width: 760px) { .h-actions { width: 100%; } .h-actions .btn-neon, .h-actions .btn-glass { width: 100%; } }
        @media (max-width: 760px) {
            .pane { padding: 20px; margin-top: 20px; }
            .filter-bar { flex-direction: column; gap: 10px; }
            .table-wrapper table { min-width: 640px; }
            .profile-modal-card { max-width: 95vw; }
            .modal-card { padding: 18px; }
            .alert-grid { grid-template-columns: 1fr; }
            .alert-head { flex-direction: column; }
            .alert-meta { text-align: left; }
        }
        @media (max-width: 640px) { .profile-grid { grid-template-columns: 1fr; } .profile-header { flex-direction: column; align-items: flex-start; } }
    </style>
</body>
</html>
