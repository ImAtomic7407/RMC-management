<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>RMC - Modern Coaching Institute</title>
    <link rel="stylesheet" href="/css/landing.css">
</head>
<body>
    <div class="landing-shell">
        <header class="topbar">
            <div class="container topbar-inner">
                <div class="brand">
                    <div class="logo-circle">R</div>
                    <div class="brand-name">RMC</div>
                </div>

                <nav class="nav">
                    <a href="#">Home</a>
                    <a href="#about">About</a>
                    <a href="#courses">Courses</a>
                    <a href="#lectures">Free Lectures</a>
                    <a href="#download-app">Download App</a>
                    <a href="#id-card-request">ID Card Request</a>
                    <button class="btn-login" type="button" onclick="window.location.href='/login'">Login</button>
                </nav>
            </div>
        </header>

        <main class="container">
            <section class="hero">
                <div>
                    <span class="pill">#1 Choice for Competitive Excellence</span>
                    <h1>
                        Unlock Your <span class="pri">Potential</span>,<br>
                        Achieve Your <span class="sec">Dreams</span>.
                    </h1>
                    <p>
                        Join RMC, where learning meets innovation. Our expert-led courses and personalized coaching are designed to
                        propel students toward academic and professional success.
                    </p>
                    <div class="cta-row">
                        <button class="btn-primary" type="button" onclick="document.getElementById('id-card-request').scrollIntoView({behavior:'smooth'})">
                            Watch Free Lectures
                        </button>
                        <button class="btn-ghost" type="button" onclick="document.getElementById('id-card-request').scrollIntoView({behavior:'smooth'})">
                            Request ID Access
                        </button>
                    </div>

                    <div class="hero-note">
                        <div class="tiny-avatars">
                            <img src="<%= landingMedia?.galleryImages?.[0] || '/landing-media/placeholder.svg' %>" alt="Student 1">
                            <img src="<%= landingMedia?.galleryImages?.[1] || '/landing-media/placeholder.svg' %>" alt="Student 2">
                            <img src="<%= landingMedia?.galleryImages?.[2] || '/landing-media/placeholder.svg' %>" alt="Student 3">
                            <img src="<%= landingMedia?.galleryImages?.[3] || '/landing-media/placeholder.svg' %>" alt="Student 4">
                        </div>
                        <div>
                            <strong>10,000+ Students Trusted Us</strong><br>
                            <span>Top results, strong mentorship, real outcomes.</span>
                        </div>
                    </div>
                </div>

                <div class="hero-media">
                    <img
                        data-hero-image
                        src="<%= landingMedia?.heroImage || '/landing-media/placeholder.svg' %>"
                        data-fallback="/landing-media/placeholder.svg"
                        alt="RMC Campus"
                    >
                    <video
                        data-hero-video
                        class="<%= landingMedia?.heroVideo ? 'hidden' : 'hidden no-media' %>"
                        autoplay
                        muted
                        loop
                        playsinline
                        poster="<%= landingMedia?.heroPoster || '/landing-media/placeholder.svg' %>"
                    >
                        <source src="<%= landingMedia?.heroVideo || '' %>" type="video/mp4">
                    </video>
                </div>
            </section>

            <!-- APP DOWNLOAD SECTION -->
            <section id="download-app" class="app-download-card">
                <div class="app-content">
                    <div class="app-info">
                        <h2>Experience RMC on <span class="sec">Mobile</span></h2>
                        <p>Get instant access to study materials, notices, and your digital ID card with the RMC Mobile App.</p>
                        <div class="download-features">
                            <div class="feat"><span class="feat-icon">âš¡</span> Stay Updated</div>
                            <div class="feat"><span class="feat-icon">ðŸ“š</span> Offline Materials</div>
                            <div class="feat"><span class="feat-icon">ðŸªª</span> Digital ID Card</div>
                        </div>
                        <a href="https://pub-45176c50a4064b7ca3a691ba71c61e97.r2.dev/rmc-mobile.apk?v=1.0.17-20260519" class="btn-primary app-btn" download="RMC-Mobile-v1.0.17.apk">
                            Download RMC Android App (.apk)
                        </a>
  <p class="app-note">Current Version: 1.0.17 (Stable) â€¢ 107.3MB</p>
                    </div>
                    <div class="app-visual">
                        <div class="phone-mockup">
                             <img src="/landing-media/app_preview.png" alt="RMC App Preview">
                        </div>
                    </div>
                </div>
            </section>

            <section id="id-card-request" class="contact-card">
                <div class="contact-head">
                    <h2>ID Card Permission Request</h2>
                    <p>Submit this request after admission. Teacher will approve the phone number for ID card generation.</p>
                </div>

                <form id="request-form" class="contact-form" autocomplete="on">
                    <div>
                        <label>Student Name</label>
                        <input class="input" type="text" name="name" placeholder="Full name" required>
                    </div>
                    <div>
                        <label>Phone</label>
                        <input class="input" type="tel" name="phone" placeholder="+91..." inputmode="tel" required>
                    </div>
                    <div class="form-actions">
                        <button class="btn-primary" id="request-submit" type="submit">Send Permission Request</button>
                        <span id="request-status" class="status" aria-live="polite"></span>
                    </div>
                </form>
            </section>
        </main>
    </div>

    <script src="/js/landing.js"></script>
</body>
</html>
