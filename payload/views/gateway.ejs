<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>RMC Academy | Gateway</title>
    <link rel="stylesheet" href="/css/index.css">
</head>
<body class="gateway-bg">
    <div class="vibrant-bg">
        <div class="blob blob-1"></div>
        <div class="blob blob-2"></div>
        <div class="blob blob-3"></div>
        <div class="blob blob-4"></div>
        <div class="blob blob-5"></div>
    </div>

    <main class="home-gateway">
        <header class="gateway-header">
            <h1 class="logo-glow">RMC<span>PORTAL</span></h1>
            <p class="subtitle">Student portal and staff access</p>
        </header>

        <section class="gateway-grid">
            <a class="glass-container gateway-card" href="/student/login">
                <div class="icon-wrap">Student</div>
                <div class="card-content">
                    <h2>Student Portal</h2>
                    <p>Study materials, notifications, and attendance history.</p>
                </div>
                <div class="card-footer">Open Portal</div>
            </a>

            <a class="glass-container gateway-card" href="/login">
                <div class="icon-wrap">Staff</div>
                <div class="card-content">
                    <h2>Staff Login</h2>
                    <p>Attendance tools, batches, materials, and reports.</p>
                </div>
                <div class="card-footer">Sign In</div>
            </a>

            <a class="glass-container gateway-card" href="/register">
                <div class="icon-wrap">Enroll</div>
                <div class="card-content">
                    <h2>New Enrollment</h2>
                    <p>Register a student and generate a QR ID card.</p>
                </div>
                <div class="card-footer">Start</div>
            </a>

<a class="glass-container gateway-card" href="https://pub-45176c50a4064b7ca3a691ba71c61e97.r2.dev/rmc-mobile.apk?v=1.0.17-20260519" download="RMC-Mobile-v1.0.17.apk">
                <div class="icon-wrap">App</div>
                <div class="card-content">
                    <h2>Android App</h2>
                    <p>Download the official RMC Mobile App for staff and students.</p>
                </div>
  <div class="card-footer">Download Latest APK</div>
            </a>
        </section>

        <footer class="gateway-footer">
            <p>2026 RMC</p>
        </footer>
    </main>

    <style>
        .gateway-bg { background: var(--bg-zen); min-height: 100vh; display: flex; align-items: center; justify-content: center; overflow-x: hidden; }
        .home-gateway { width: 100%; max-width: 1100px; padding: 40px 20px; position: relative; z-index: 10; }
        .gateway-header { text-align: center; margin-bottom: 50px; }
        .logo-glow { font-size: clamp(2.2rem, 5vw, 3.6rem); font-weight: 900; letter-spacing: 3px; color: var(--zen-primary); }
        .logo-glow span { color: var(--zen-secondary); }
        .subtitle { color: var(--text-secondary); letter-spacing: 1px; font-size: 0.95rem; margin-top: 10px; font-weight: 600; }
        .gateway-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 24px; }
        .gateway-card { 
            padding: 32px; min-height: 300px; display: flex; flex-direction: column; justify-content: space-between; 
            cursor: pointer; text-decoration: none; border-radius: 48px; border: 1px solid var(--glass-border);
            background: var(--glass-bg); box-shadow: 0 40px 80px rgba(26, 43, 29, 0.1);
        }
        .icon-wrap { font-size: 0.85rem; letter-spacing: 1px; text-transform: uppercase; color: var(--text-secondary); font-weight: 800; opacity: 0.6; }
        .gateway-card h2 { font-size: 1.6rem; color: var(--zen-primary); margin-top: 10px; font-weight: 800; }
        .gateway-card p { font-size: 1rem; color: var(--text-secondary); line-height: 1.6; margin-top: 10px; font-weight: 500; }
        .card-footer { font-weight: 800; color: var(--zen-secondary); font-size: 1rem; margin-top: 24px; text-decoration: underline; text-underline-offset: 4px; }
        .gateway-footer { margin-top: 40px; text-align: center; color: var(--text-secondary); opacity: 0.4; font-size: 0.85rem; font-weight: 700; }
        
        .gateway-card:hover {
            transform: translateY(-12px) scale(1.02);
            box-shadow: 0 50px 100px rgba(26, 43, 29, 0.15);
        }
    </style>
</body>
</html>
